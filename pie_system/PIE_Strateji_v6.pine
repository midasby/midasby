//@version=6
// ============================================================================
//  PIE STRATEJİ v6 — "Price is Everything / Redsword" • Pine Script v6
// ----------------------------------------------------------------------------
//  ŞARTNAME UYGULAMASI (saf Price Action, gecikmeli indikatör YOK):
//   • Bölgeler mum GÖVDELERİYLE çizilir; fitiller sadece SL dış sınırıdır
//   • Hacimli Engulf + Bobin + Testere(Tuzak) + Boşalt-Doldur/İstekli Mum
//   • Limit emir YOK → bölgeden BAŞARILI TEST alınınca kapanışta MARKET giriş
//   • SL: fitil ucu + spread payı • TP: min 1:2 RR
//   • TP1'de (%1-1.5R) pozisyonun %60'ı kapanır → stop başabaşa
//   • Kalan %40 karşıt majör bölgeye kadar yapısal iz süren stopla taşınır
//
//  v6 GÖRSEL PAKETİ:
//   🟩 Pozisyon Risk/Ödül kutuları (girişten itibaren canlı yeşil kâr /
//      kırmızı risk alanı, TP1 kesikli çizgisi, iz süren stop çizgisi)
//   🏷 Kapanan her işlemde KAZANÇ ✔ / KAYIP ✘ rozeti (net sonuç yazar)
//   📊 Canlı performans paneli: durum, yön eğilimi, işlem sayısı, kazanma
//      oranı, profit factor, net kâr, aktif bölgeler
//   🎨 Modern palet, durum emojili bölge kutuları, temiz etiketler
//
//  v6.2 SADE GRAFİK: mum üstü yazılar (KAZANÇ/KAYIP rozeti, bölge yazıları,
//   giriş bilgi kartı, mum işaretleri) varsayılan KAPALI — grafik okunur
//   kalır; isteyen 🎨 Görünüm ayarlarından tek tek açabilir. Sonuçlar
//   performans panelinde ve Strateji Test aracında zaten görünür.
// ============================================================================
strategy("PIE STRATEJİ v6", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, pyramiding=0, calc_on_every_tick=false, process_orders_on_close=true, max_boxes_count=300, max_labels_count=400, max_lines_count=200, commission_type=strategy.commission.percent, commission_value=0.0)

// ═══════════════════════════  GİRDİLER (INPUTS)  ═══════════════════════════
grpR = "🎯 Risk Yönetimi"
riskPct    = input.float(1.0, "İşlem başına risk (%)", minval=0.1, maxval=5.0, step=0.1, group=grpR)
minRR      = input.float(2.0, "Minimum Risk-Ödül Oranı", minval=1.5, maxval=5.0, step=0.5, group=grpR)
tp1RR      = input.float(1.5, "TP1 seviyesi (R)", minval=0.5, maxval=3.0, step=0.25, group=grpR, tooltip="Tek TP modunda tüm pozisyonun hedefi; Kısmi+Runner modunda kısmi kar seviyesi")
cikisMod   = input.string("Kısmi + Runner", "Çıkış Modu", options=["Kısmi + Runner","Tek TP (Yüksek İsabet)"], group=grpR, tooltip="Tek TP: pozisyonun tamamı TP1 seviyesinde kapanır. Backtest: TP=1.25R ile H1'de ~%55, TP=0.5R ile ~%67 isabet (beklenti düşer).")
partialPct = input.float(60.0, "Kısmi Kar Al Oranı (%)", minval=30.0, maxval=80.0, step=5.0, group=grpR)
spreadTick = input.int(10, "SL spread payı (tick)", minval=0, maxval=100, group=grpR)

grpB = "📦 Bölge Ayarları"
bobinMin   = input.int(3, "Bobin için Minimum Mum Sayısı", minval=3, maxval=10, group=grpB)
bobinWid   = input.float(1.2, "Bobin maksimum genişlik (ATR x)", minval=0.5, maxval=3.0, step=0.1, group=grpB)
momK       = input.float(1.3, "Hacimli mum çarpanı", minval=1.1, maxval=2.5, step=0.1, group=grpB)
maxZone    = input.int(8, "Yön başına maksimum aktif bölge", minval=3, maxval=15, group=grpB)
yonFiltre  = input.bool(true, "Yön filtresi: son kırılım yönünde işlem", group=grpB)

grpS = "🧪 Başarı Filtreleri (v6.1)"
seansF    = input.bool(true, "1) Seans filtresi (Londra+NY killzone)", group=grpS, tooltip="Sadece belirtilen saat aralıklarındaki sinyaller alınır. Asya testere bölgesi elenir.")
sess1     = input.session("1000-1300", "   Seans 1 (TR saati)", group=grpS)
sess2     = input.session("1530-1900", "   Seans 2 (TR saati)", group=grpS)
ilkTest   = input.bool(true, "2) Sadece İLK test (taze bölge)", group=grpS, tooltip="Bölgenin daha önce test edilmemiş olması şartı. PIE: ilk test en yüksek olasılıktır.")
yaklasimF = input.bool(false, "3) Hacimsiz yaklaşım şartı", group=grpS, tooltip="Bölgeye küçülen gövdelerle gelinmiş olmalı (son 3 mum ortalama altı). Kurumsal realizasyon izi.")
rrKontrol = input.bool(true, "4) RR ön kontrolü (yol temiz mi)", group=grpS, tooltip="En yakın karşıt bölge min RR mesafesinden yakınsa işlem atlanır — hedefin önü kapalıysa girme.")
kaliteEng = input.bool(false, "7) Kaliteli engulf (uçta kapanış)", group=grpS, tooltip="Engulf mumu kendi aralığının üst %30'unda (satışta alt %30) kapanmalı.")
timeStop  = input.int(10, "6) Zaman stopu (bar, 0=kapalı)", minval=0, maxval=40, group=grpS, tooltip="İşlem bu kadar barda TP1'e ulaşamazsa kapatılır. Ölü işlemler elenir.")

grpV = "🎨 Görünüm"
zoneShow   = input.bool(true, "Arz/Talep bölgeleri", group=grpV)
zoneTxt    = input.bool(false, "Bölge kutu yazıları (TALEP/ARZ...)", group=grpV, tooltip="Kapalıyken bölgeler sadece renkli kutu olarak çizilir, üzerlerine yazı yazılmaz. Grafik temiz kalır.")
fadeShow   = input.bool(false, "Kırılan bölgeleri soluk bırak", group=grpV)
posShow    = input.bool(true, "Pozisyon Risk/Ödül kutuları", group=grpV)
girisKart  = input.bool(false, "Giriş bilgi kartı (SL/TP yazısı)", group=grpV, tooltip="Girişte fiyatın yanına SL/TP1/Hedef değerlerini yazan kart. Grafiği kapatmaması için varsayılan kapalı.")
rozetShow  = input.bool(false, "Kazanç/Kayıp rozetleri", group=grpV, tooltip="Kapanan işlemlerde mumların üstüne KAZANÇ/KAYIP yazan rozetler. Grafiği kapatmaması için varsayılan kapalı — sonuçlar performans panelinde ve Strateji Test aracında zaten görünür.")
lblShow    = input.bool(false, "İstekli mum / test etiketleri", group=grpV, tooltip="Mum üstü üçgen/elmas işaretleri. Varsayılan kapalı.")
panelShow  = input.bool(true, "Performans paneli", group=grpV)
panelPos   = input.string("Sağ Üst", "Panel konumu", options=["Sağ Üst","Sağ Alt","Sol Üst","Sol Alt"], group=grpV)

// ── Modern renk paleti ──
C_DEM   = #00e676      // Talep yeşili
C_SUP   = #ff5370      // Arz kırmızısı
C_GOLD  = #ffcb6b      // Vurgu altını
C_BLUE  = #82aaff      // Bilgi mavisi
C_TEAL  = #00bcd4      // Testere/nötr
C_BG    = #0f1420      // Panel zemini

// ═══════════════════════  BAR ANATOMİSİ (SAF FİYAT)  ═══════════════════════
body    = math.abs(close - open)                    // Mum gövdesi
rng     = high - low                                // Toplam aralık
upWick  = high - math.max(close, open)              // Üst fitil
dnWick  = math.min(close, open) - low               // Alt fitil
bull    = close > open
bear    = close < open
bodyTop = math.max(close, open)
bodyBot = math.min(close, open)
avgBody = ta.sma(body, 20)                          // Ölçek referansı (osilatör değil)
atrW    = ta.atr(14)                                // Sadece genişlik ölçümü için
spread  = spreadTick * syminfo.mintick              // SL spread payı

momBar  = body > avgBody * momK and rng > 0         // Hacimli/momentumlu mum

// İSTEKLİ MUM: hareket yönündeki fitil arkadakinden belirgin uzun (kademe temizler)
istekliBull = bull and upWick > dnWick * 2 and dnWick < rng * 0.15 and upWick > rng * 0.2
istekliBear = bear and dnWick > upWick * 2 and upWick < rng * 0.15 and dnWick > rng * 0.2
safBull     = bull and dnWick < rng * 0.1 and upWick < rng * 0.1 and body > avgBody   // İğnesiz saf mum
safBear     = bear and dnWick < rng * 0.1 and upWick < rng * 0.1 and body > avgBody

// PIN BAR (test teyidi)
pinBull = rng > atrW * 0.5 and body < rng * 0.34 and dnWick > rng * 0.55
pinBear = rng > atrW * 0.5 and body < rng * 0.34 and upWick > rng * 0.55

// ═════════════════  A) HACİMLİ ENGULF (GÖVDE BAZLI YUTMA)  ═════════════════
// Filtre 7: kaliteli engulf = mum kendi aralığının ucunda kapanır (kararlılık izi)
engQBull = not kaliteEng or (rng > 0 and (close - low) / rng > 0.7)
engQBear = not kaliteEng or (rng > 0 and (high - close) / rng > 0.7)
engulfBull = bear[1] and bull and body > body[1] and close > open[1] and momBar and engQBull
engulfBear = bull[1] and bear and body > body[1] and close < open[1] and momBar and engQBear

// ═════════════════════  B) BOBİN (SIKIŞMA) TESPİTİ  ════════════════════════
hhB  = ta.highest(bodyTop, bobinMin)                // Gövde tavanı
llB  = ta.lowest(bodyBot, bobinMin)                 // Gövde tabanı
hhW  = ta.highest(high, bobinMin)                   // Fitil tavanı (SL dış sınırı)
llW  = ta.lowest(low, bobinMin)                     // Fitil tabanı
minB = ta.lowest(body, bobinMin)
bobinKosul = (hhB - llB) < atrW * bobinWid and minB > 0

var float bobT  = na
var float bobB  = na
var float bobHi = na
var float bobLo = na
var int   bobT0 = na
var int   bobN  = 0
var bool  inBob = false
bobinBreakUp = false
bobinBreakDn = false
if not inBob and bobinKosul
    inBob := true
    bobT := hhB
    bobB := llB
    bobHi := hhW
    bobLo := llW
    bobT0 := time[bobinMin - 1]
    bobN := bobinMin
else if inBob
    bobN += 1
    if close > bobT and momBar                      // HACİMLİ yukarı kırılım
        bobinBreakUp := true
        inBob := false
    else if close < bobB and momBar                 // HACİMLİ aşağı kırılım
        bobinBreakDn := true
        inBob := false
    else if bodyTop <= bobT + atrW * 0.1 and bodyBot >= bobB - atrW * 0.1
        bobT := math.max(bobT, bodyTop)
        bobB := math.min(bobB, bodyBot)
        bobHi := math.max(bobHi, high)
        bobLo := math.min(bobLo, low)
    else
        inBob := false                              // Hacimsiz taşma → dağıldı
    if bobN > 20
        inBob := false                              // Bayat sıkışma iptal

// ═══════════════════════  BÖLGE (KUTU) YÖNETİMİ  ═══════════════════════════
var zBox = array.new_box()
var zTop = array.new_float()
var zBot = array.new_float()
var zExt = array.new_float()                        // En uç FİTİL noktası (SL için)
var zDir = array.new_int()                          // 1=TALEP  -1=ARZ
var zTst = array.new_int()                          // Bölgenin test sayısı (Filtre 2: ilk test)

addBox(_t0, _top, _bot, _dir, _txt) =>
    box.new(left=_t0, top=_top, right=time, bottom=_bot, xloc=xloc.bar_time, extend=extend.right, bgcolor=color.new(_dir == 1 ? C_DEM : C_SUP, 88), border_color=color.new(_dir == 1 ? C_DEM : C_SUP, 45), border_width=1, text=zoneTxt ? _txt : "", text_size=size.tiny, text_color=color.new(color.white, 40), text_halign=text.align_right, text_valign=_dir == 1 ? text.align_bottom : text.align_top)

nTop = float(na)
nBot = float(na)
nExt = float(na)
nDir = 0
nT0  = time
nTxt = ""
if engulfBull                                       // Boğa engulf → ilk mumun GÖVDESİ talep bölgesi
    nTop := bodyTop[1]
    nBot := bodyBot[1]
    nExt := math.min(low, low[1])
    nDir := 1
    nT0  := time[1]
    nTxt := "🟢 TALEP • ENGULF"
if engulfBear
    nTop := bodyTop[1]
    nBot := bodyBot[1]
    nExt := math.max(high, high[1])
    nDir := -1
    nT0  := time[1]
    nTxt := "🔴 ARZ • ENGULF"
if bobinBreakUp                                     // Bobin yukarı → kutu talep olur
    nTop := bobT
    nBot := bobB
    nExt := bobLo
    nDir := 1
    nT0  := bobT0
    nTxt := "🟢 TALEP • BOBİN"
if bobinBreakDn
    nTop := bobT
    nBot := bobB
    nExt := bobHi
    nDir := -1
    nT0  := bobT0
    nTxt := "🔴 ARZ • BOBİN"

var int bias = 0                                    // Son hacimli kırılımın yönü = trend eğilimi
if bobinBreakUp
    bias := 1
if bobinBreakDn
    bias := -1

if not na(nTop) and nTop > nBot and zoneShow
    dup = false
    if array.size(zTop) > 0
        for i = 0 to array.size(zTop) - 1
            ov = math.min(array.get(zTop, i), nTop) - math.max(array.get(zBot, i), nBot)
            if ov > (nTop - nBot) * 0.6
                dup := true
    if not dup
        nb = addBox(nT0, nTop, nBot, nDir, nTxt)
        array.push(zBox, nb)
        array.push(zTop, nTop)
        array.push(zBot, nBot)
        array.push(zExt, nExt)
        array.push(zDir, nDir)
        array.push(zTst, 0)
        cntD = 0
        cntS = 0
        for i = 0 to array.size(zDir) - 1
            if array.get(zDir, i) == 1
                cntD += 1
            else
                cntS += 1
        if cntD > maxZone or cntS > maxZone
            delDir = cntD > maxZone ? 1 : -1
            for i = 0 to array.size(zDir) - 1
                if array.get(zDir, i) == delDir
                    box.delete(array.get(zBox, i))
                    array.remove(zBox, i)
                    array.remove(zTop, i)
                    array.remove(zBot, i)
                    array.remove(zExt, i)
                    array.remove(zDir, i)
                    array.remove(zTst, i)
                    break

// ═══════════════  C) BÖLGE İPTALİ + TESTERE (TUZAK) MODÜLÜ  ════════════════
var float lbTop = na
var float lbBot = na
var int   lbBar = -999
var int   lbDir = 0

inDem   = false
inSup   = false
demTopA = float(na)
demExtA = float(na)
supBotA = float(na)
supExtA = float(na)
demTstA = 99                                        // Değilen talep bölgesinin ÖNCEKİ test sayısı
supTstA = 99                                        // Değilen arz bölgesinin ÖNCEKİ test sayısı

if array.size(zBox) > 0
    for i = array.size(zBox) - 1 to 0
        t   = array.get(zTop, i)
        btm = array.get(zBot, i)
        ext = array.get(zExt, i)
        d   = array.get(zDir, i)
        bx  = array.get(zBox, i)
        if d == 1 and bodyTop < btm                 // TALEP iptali: gövde TAMAMEN altta kapandı
            if fadeShow
                box.set_right(bx, time)
                box.set_extend(bx, extend.none)
                box.set_bgcolor(bx, color.new(color.gray, 90))
                box.set_border_color(bx, color.new(color.gray, 70))
                box.set_text(bx, zoneTxt ? "✂ KIRILDI" : "")
            else
                box.delete(bx)
            array.remove(zBox, i)
            array.remove(zTop, i)
            array.remove(zBot, i)
            array.remove(zExt, i)
            array.remove(zDir, i)
            array.remove(zTst, i)
            lbTop := t
            lbBot := btm
            lbBar := bar_index
            lbDir := -1
            bias := -1                              // Kırılan yön trend yönüdür
        else if d == -1 and bodyBot > t             // ARZ iptali: gövde TAMAMEN üstte kapandı
            if fadeShow
                box.set_right(bx, time)
                box.set_extend(bx, extend.none)
                box.set_bgcolor(bx, color.new(color.gray, 90))
                box.set_border_color(bx, color.new(color.gray, 70))
                box.set_text(bx, zoneTxt ? "✂ KIRILDI" : "")
            else
                box.delete(bx)
            array.remove(zBox, i)
            array.remove(zTop, i)
            array.remove(zBot, i)
            array.remove(zExt, i)
            array.remove(zDir, i)
            array.remove(zTst, i)
            lbTop := t
            lbBot := btm
            lbBar := bar_index
            lbDir := 1
            bias := 1
        else
            if d == 1 and low <= t and high >= btm  // Aktif talep bölgesine temas
                inDem := true
                if na(demTopA) or t > demTopA
                    demTopA := t
                    demExtA := math.min(ext, btm)
                    demTstA := array.get(zTst, i)   // Girişten ÖNCEKİ test sayısı (taze=0)
                if close > t                        // Temas + üstünde kapanış = bir test tüketildi
                    array.set(zTst, i, array.get(zTst, i) + 1)
                    if array.get(zTst, i) >= 3      // PIE: çok test edilen bölge çöptür
                        box.set_right(bx, time)
                        box.set_extend(bx, extend.none)
                        box.set_bgcolor(bx, color.new(color.gray, 92))
                        box.set_text(bx, zoneTxt ? "🗑 ÇÖP" : "")
                        array.remove(zBox, i)
                        array.remove(zTop, i)
                        array.remove(zBot, i)
                        array.remove(zExt, i)
                        array.remove(zDir, i)
                        array.remove(zTst, i)
            else if d == -1 and high >= btm and low <= t // Aktif arz bölgesine temas
                inSup := true
                if na(supBotA) or btm < supBotA
                    supBotA := btm
                    supExtA := math.max(ext, t)
                    supTstA := array.get(zTst, i)
                if close < btm
                    array.set(zTst, i, array.get(zTst, i) + 1)
                    if array.get(zTst, i) >= 3
                        box.set_right(bx, time)
                        box.set_extend(bx, extend.none)
                        box.set_bgcolor(bx, color.new(color.gray, 92))
                        box.set_text(bx, zoneTxt ? "🗑 ÇÖP" : "")
                        array.remove(zBox, i)
                        array.remove(zTop, i)
                        array.remove(zBot, i)
                        array.remove(zExt, i)
                        array.remove(zDir, i)
                        array.remove(zTst, i)

// TESTERE: kırılımdan sonra 1-2 mumda ters tarafa TAM GÖVDE geçişi → tuzak
testereUp = false
testereDn = false
if lbDir == -1 and bar_index - lbBar <= 2 and bodyBot > lbTop
    testereUp := true
    lbDir := 0
    bias := 1
if lbDir == 1 and bar_index - lbBar <= 2 and bodyTop < lbBot
    testereDn := true
    lbDir := 0
    bias := -1

if testereUp and zoneShow                           // Tuzağı çözen mumun gövdesi TALEP
    nb = addBox(time, bodyTop, bodyBot, 1, "♻️ TALEP • TESTERE")
    array.push(zBox, nb)
    array.push(zTop, bodyTop)
    array.push(zBot, bodyBot)
    array.push(zExt, low)
    array.push(zDir, 1)
    array.push(zTst, 0)
if testereDn and zoneShow
    nb = addBox(time, bodyTop, bodyBot, -1, "♻️ ARZ • TESTERE")
    array.push(zBox, nb)
    array.push(zTop, bodyTop)
    array.push(zBot, bodyBot)
    array.push(zExt, high)
    array.push(zDir, -1)
    array.push(zTst, 0)

// ═══════════  D) BOŞALT-DOLDUR (FİTİL DOLDURMA + TERS TEYİT)  ═══════════════
spikeDn = dnWick[1] > body[1] and dnWick[1] > atrW * 0.6
spikeUp = upWick[1] > body[1] and upWick[1] > atrW * 0.6
dolduranBull = spikeDn and low <= low[1] + dnWick[1] * 0.5 and (engulfBull or pinBull or istekliBull) and close > bodyBot[1]
dolduranBear = spikeUp and high >= high[1] - upWick[1] * 0.5 and (engulfBear or pinBear or istekliBear) and close < bodyTop[1]

// ═══════════════════  GİRİŞ SİNYALLERİ (BAŞARILI TEST)  ════════════════════
testBull = engulfBull or pinBull or istekliBull or safBull or dolduranBull
testBear = engulfBear or pinBear or istekliBear or safBear or dolduranBear

longRaw  = inDem and testBull and close > demTopA   // Bölge testi + bölge ÜSTÜNDE kapanış
shortRaw = inSup and testBear and close < supBotA

// Filtre 1: Seans (Londra + NY killzone, TR saati)
sessOk = not seansF or not na(time(timeframe.period, sess1, "Europe/Istanbul")) or not na(time(timeframe.period, sess2, "Europe/Istanbul"))
// Filtre 3: Hacimsiz yaklaşım — bölgeye küçülen gövdelerle gelinmiş olmalı
yaklOk = not yaklasimF or (body[1] + body[2] + body[3]) / 3 < avgBody
// Filtre 2: İlk test — bölge daha önce hiç test edilmemiş olmalı
ilkDemOk = not ilkTest or demTstA == 0
ilkSupOk = not ilkTest or supTstA == 0

longOk  = longRaw and (not yonFiltre or bias >= 0) and sessOk and yaklOk and ilkDemOk and strategy.position_size == 0 and barstate.isconfirmed
shortOk = shortRaw and (not yonFiltre or bias <= 0) and sessOk and yaklOk and ilkSupOk and strategy.position_size == 0 and barstate.isconfirmed

// ═══════════════  POZİSYON YÖNETİMİ: SL / KISMİ TP / İZ SÜREN  ═════════════
var float entryP  = na
var float slP     = na
var float tp1P    = na
var float runP    = na
var float trailP  = na
var bool  tp1Done = false
var int   entryT  = na
var int   entryBar = na                             // Giriş barı (Filtre 6: zaman stopu)                              // Giriş zamanı (pozisyon kutuları için)

oppTargetLong() =>
    tgt = float(na)
    if array.size(zDir) > 0
        for i = 0 to array.size(zDir) - 1
            if array.get(zDir, i) == -1
                b = array.get(zBot, i)
                if b > close
                    if na(tgt) or b < tgt
                        tgt := b
    tgt
oppTargetShort() =>
    tgt = float(na)
    if array.size(zDir) > 0
        for i = 0 to array.size(zDir) - 1
            if array.get(zDir, i) == 1
                t = array.get(zTop, i)
                if t < close
                    if na(tgt) or t > tgt
                        tgt := t
    tgt

// ── 🟩 Pozisyon Risk/Ödül görsel nesneleri ──
var box   posRisk  = na                             // Kırmızı risk alanı (giriş↔SL)
var box   posProf  = na                             // Yeşil kâr alanı (giriş↔hedef)
var line  posTP1   = na                             // TP1 kesikli çizgisi
var line  posTrail = na                             // İz süren stop çizgisi
var label posLbl   = na                             // Giriş bilgi kartı
// (Pine kuralı: global var'lar fonksiyon içinde değiştirilemez → görseller
//  giriş bloklarından sonra global kapsamda tek seferde oluşturulur)

// --- LONG giriş (Filtre 4: hedefin önü kapalıysa işlem atlanır)
girisL = false
if longOk
    slRef = na(demExtA) ? low : math.min(low, demExtA)     // SL referansı: sinyal fitili / bölge uç fitili
    eP    = close                                          // Aday giriş
    sP    = slRef - spread                                 // Aday SL
    rD    = math.max(eP - sP, syminfo.mintick * 10)        // 1R
    opp   = oppTargetLong()                                // Yoldaki en yakın karşıt bölge
    rrOk  = not rrKontrol or na(opp) or opp >= eP + rD * minRR   // Yol temiz mi?
    if rrOk
        girisL := true
        entryP := eP
        slP    := sP
        tp1P   := eP + rD * tp1RR
        runP   := na(opp) or opp < eP + rD * minRR ? eP + rD * minRR : opp
        trailP := sP
        tp1Done := false
        entryT := time
        entryBar := bar_index
        qty = strategy.equity * riskPct / 100 / rD
        strategy.entry("LONG", strategy.long, qty=qty)

// --- SHORT giriş (Filtre 4 dahil)
girisS = false
if shortOk
    slRef = na(supExtA) ? high : math.max(high, supExtA)
    eP    = close
    sP    = slRef + spread
    rD    = math.max(sP - eP, syminfo.mintick * 10)
    opp   = oppTargetShort()
    rrOk  = not rrKontrol or na(opp) or opp <= eP - rD * minRR
    if rrOk
        girisS := true
        entryP := eP
        slP    := sP
        tp1P   := eP - rD * tp1RR
        runP   := na(opp) or opp > eP - rD * minRR ? eP - rD * minRR : opp
        trailP := sP
        tp1Done := false
        entryT := time
        entryBar := bar_index
        qty = strategy.equity * riskPct / 100 / rD
        strategy.entry("SHORT", strategy.short, qty=qty)

// --- Pozisyon görsellerini oluştur (global kapsam — giriş anında bir kez)
if (girisL or girisS) and posShow
    isL = girisL                                    // Yön bayrağı
    if not na(posRisk)                              // Önceki işlemin nesnelerini temizle
        box.delete(posRisk)
    if not na(posProf)
        box.delete(posProf)
    if not na(posTP1)
        line.delete(posTP1)
    if not na(posTrail)
        line.delete(posTrail)
    if not na(posLbl)
        label.delete(posLbl)
    posRisk := box.new(left=time, top=isL ? entryP : slP, right=time, bottom=isL ? slP : entryP, xloc=xloc.bar_time, bgcolor=color.new(C_SUP, 82), border_color=color.new(C_SUP, 55), border_width=1)                                   // Risk alanı: giriş↔SL
    posProf := box.new(left=time, top=isL ? runP : entryP, right=time, bottom=isL ? entryP : runP, xloc=xloc.bar_time, bgcolor=color.new(C_DEM, 84), border_color=color.new(C_DEM, 55), border_width=1)                                 // Kâr alanı: giriş↔hedef
    posTP1 := line.new(x1=time, y1=tp1P, x2=time, y2=tp1P, xloc=xloc.bar_time, color=color.new(C_GOLD, 15), style=line.style_dashed, width=1)                                                                                            // TP1 kesikli
    posTrail := line.new(x1=time, y1=trailP, x2=time, y2=trailP, xloc=xloc.bar_time, color=color.new(color.orange, 10), style=line.style_solid, width=2)                                                                                 // İz süren stop
    if girisKart
        posLbl := label.new(x=time, y=entryP, xloc=xloc.bar_time, yloc=yloc.price, style=isL ? label.style_label_upper_right : label.style_label_lower_right, color=color.new(isL ? C_DEM : C_SUP, 15), textcolor=isL ? color.black : color.white, size=size.small, text=(isL ? "▲ LONG" : "▼ SHORT") + "  @" + str.tostring(entryP, format.mintick) + "\nSL " + str.tostring(slP, format.mintick) + " • TP1 " + str.tostring(tp1P, format.mintick) + "\nHedef " + str.tostring(runP, format.mintick))   // Bilgi kartı (varsayılan kapalı)

// --- Pozisyon açıkken yönetim + görsel güncelleme
plLow  = ta.pivotlow(low, 2, 2)
plHigh = ta.pivothigh(high, 2, 2)
if strategy.position_size > 0
    if not tp1Done and high >= tp1P
        tp1Done := true
        trailP := math.max(trailP, entryP)          // Kısmi sonrası stop başabaşa
    if tp1Done and not na(plLow)
        trailP := math.max(trailP, plLow - spread)  // Her yapısal dip stopu taşır
    if timeStop > 0 and not tp1Done and bar_index - entryBar >= timeStop   // Filtre 6: TP1 görülmeden süre doldu
        strategy.close("LONG", comment="Zaman Stopu")
    if cikisMod == "Tek TP (Yüksek İsabet)"
        strategy.exit("TP", from_entry="LONG", qty_percent=100, limit=tp1P, stop=slP)   // Tamamı TP1'de kapanır
    else
        strategy.exit("TP1", from_entry="LONG", qty_percent=partialPct, limit=tp1P, stop=slP)
        strategy.exit("RUN", from_entry="LONG", qty_percent=100, limit=runP, stop=trailP)
if strategy.position_size < 0
    if not tp1Done and low <= tp1P
        tp1Done := true
        trailP := math.min(trailP, entryP)
    if tp1Done and not na(plHigh)
        trailP := math.min(trailP, plHigh + spread)
    if timeStop > 0 and not tp1Done and bar_index - entryBar >= timeStop
        strategy.close("SHORT", comment="Zaman Stopu")
    if cikisMod == "Tek TP (Yüksek İsabet)"
        strategy.exit("TP", from_entry="SHORT", qty_percent=100, limit=tp1P, stop=slP)
    else
        strategy.exit("TP1", from_entry="SHORT", qty_percent=partialPct, limit=tp1P, stop=slP)
        strategy.exit("RUN", from_entry="SHORT", qty_percent=100, limit=runP, stop=trailP)

// Pozisyon görsellerini sağa doğru büyüt + trail çizgisini güncelle
if posShow and strategy.position_size != 0
    if not na(posRisk)
        box.set_right(posRisk, time)
    if not na(posProf)
        box.set_right(posProf, time)
    if not na(posTP1)
        line.set_x2(posTP1, time)
    if not na(posTrail)
        line.set_x2(posTrail, time)
        line.set_y1(posTrail, trailP)
        line.set_y2(posTrail, trailP)

// --- Kapanış: sonuç rozeti + değişken sıfırlama
var float lastNP = 0.0                              // Son net kâr (fark için)
if strategy.position_size == 0 and strategy.position_size[1] != 0
    tradePnl = strategy.netprofit - lastNP          // Bu işlemin toplam sonucu (kısmi dahil)
    lastNP := strategy.netprofit
    if rozetShow
        win = tradePnl >= 0
        label.new(x=time, y=win ? low - atrW * 0.6 : high + atrW * 0.6, xloc=xloc.bar_time, yloc=yloc.price, style=win ? label.style_label_up : label.style_label_down, color=color.new(win ? C_DEM : C_SUP, 10), textcolor=win ? color.black : color.white, size=size.small, text=(win ? "✔ KAZANÇ " : "✘ KAYIP ") + str.tostring(tradePnl, "#.##"))
    if posShow                                      // Kutuları dondur
        if not na(posRisk)
            box.set_right(posRisk, time)
        if not na(posProf)
            box.set_right(posProf, time)
    entryP := na
    slP := na
    tp1P := na
    runP := na
    trailP := na
    tp1Done := false

// ═════════════════════════════  GÖRSELLER  ═════════════════════════════════
plotshape(lblShow and istekliBull, title="İstekli Boğa", style=shape.triangleup, location=location.belowbar, color=color.new(C_GOLD, 30), size=size.tiny)
plotshape(lblShow and istekliBear, title="İstekli Ayı", style=shape.triangledown, location=location.abovebar, color=color.new(C_GOLD, 30), size=size.tiny)
plotshape(lblShow and (safBull or safBear), title="Saf Mum", style=shape.diamond, location=location.abovebar, color=color.new(C_BLUE, 40), size=size.tiny)
plotshape(girisL, title="LONG Test Girişi", style=shape.labelup, location=location.belowbar, color=color.new(C_DEM, 0), textcolor=color.black, size=size.tiny, text="AL")
plotshape(girisS, title="SHORT Test Girişi", style=shape.labeldown, location=location.abovebar, color=color.new(C_SUP, 0), textcolor=color.white, size=size.tiny, text="SAT")
plotshape(testereUp, title="Testere Yukarı", style=shape.xcross, location=location.belowbar, color=color.new(C_TEAL, 15), size=size.tiny)
plotshape(testereDn, title="Testere Aşağı", style=shape.xcross, location=location.abovebar, color=color.new(#ff9100, 15), size=size.tiny)

// ═════════════════════  📊 PERFORMANS PANELİ  ══════════════════════════════
posTbl = panelPos == "Sağ Üst" ? position.top_right : panelPos == "Sağ Alt" ? position.bottom_right : panelPos == "Sol Üst" ? position.top_left : position.bottom_left
var table tbl = table.new(posTbl, 2, 9, bgcolor=color.new(C_BG, 10), border_width=1, border_color=color.new(color.gray, 72), frame_color=color.new(C_GOLD, 60), frame_width=1)

if panelShow and barstate.islast
    cntD3 = 0
    cntS3 = 0
    if array.size(zDir) > 0
        for i = 0 to array.size(zDir) - 1
            if array.get(zDir, i) == 1
                cntD3 += 1
            else
                cntS3 += 1
    tot   = strategy.closedtrades
    wins  = strategy.wintrades
    wr    = tot > 0 ? math.round(wins * 100.0 / tot) : 0
    gp    = strategy.grossprofit
    gl    = strategy.grossloss
    pf    = gl > 0 ? gp / gl : gp > 0 ? 99.9 : 0.0
    durum = strategy.position_size > 0 ? "🟢 LONG AKTİF" : strategy.position_size < 0 ? "🔴 SHORT AKTİF" : "⚪ BEKLEMEDE"
    durumC = strategy.position_size > 0 ? C_DEM : strategy.position_size < 0 ? C_SUP : color.gray
    table.cell(tbl, 0, 0, "PIE STRATEJİ v6", text_color=C_GOLD, text_size=size.small, bgcolor=color.new(#1a2030, 0))
    table.cell(tbl, 1, 0, syminfo.ticker + " • " + timeframe.period, text_color=color.white, text_size=size.small, bgcolor=color.new(#1a2030, 0))
    table.cell(tbl, 0, 1, "Durum", text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 1, durum, text_color=durumC, text_size=size.tiny)
    table.cell(tbl, 0, 2, "Yön Eğilimi (kırılım)", text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 2, bias > 0 ? "▲ YUKARI" : bias < 0 ? "▼ AŞAĞI" : "≈ NÖTR", text_color=bias > 0 ? C_DEM : bias < 0 ? C_SUP : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 3, "Aktif Bölgeler", text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 3, "🟢 " + str.tostring(cntD3) + "  /  🔴 " + str.tostring(cntS3), text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 4, "İşlem Sayısı", text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 4, str.tostring(tot), text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 5, "Kazanma Oranı", text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 5, str.tostring(wr) + "%", text_color=wr >= 55 ? C_DEM : wr >= 45 ? C_GOLD : C_SUP, text_size=size.tiny)
    table.cell(tbl, 0, 6, "Profit Factor", text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 6, str.tostring(pf, "#.##"), text_color=pf >= 1.5 ? C_DEM : pf >= 1.0 ? C_GOLD : C_SUP, text_size=size.tiny)
    table.cell(tbl, 0, 7, "Net Kâr", text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 7, str.tostring(strategy.netprofit, "#.##"), text_color=strategy.netprofit >= 0 ? C_DEM : C_SUP, text_size=size.tiny)
    table.cell(tbl, 0, 8, "Kısmi TP / Min RR", text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 8, "%" + str.tostring(partialPct, "#") + " @" + str.tostring(tp1RR, "#.##") + "R  /  1:" + str.tostring(minRR, "#.#"), text_color=C_BLUE, text_size=size.tiny)

// ═════════════════════════════  ALARMLAR  ══════════════════════════════════
alertcondition(girisL or girisS, title="PIE STRATEJİ: Giriş", message="PIE STRATEJİ giriş sinyali — grafiği kontrol et")
if girisL
    alert("PIE STRATEJİ ▲ LONG | " + syminfo.ticker + " " + timeframe.period + " | Giriş " + str.tostring(close, format.mintick) + " | SL " + str.tostring(slP, format.mintick) + " | TP1 " + str.tostring(tp1P, format.mintick) + " | Hedef " + str.tostring(runP, format.mintick), alert.freq_once_per_bar_close)
if girisS
    alert("PIE STRATEJİ ▼ SHORT | " + syminfo.ticker + " " + timeframe.period + " | Giriş " + str.tostring(close, format.mintick) + " | SL " + str.tostring(slP, format.mintick) + " | TP1 " + str.tostring(tp1P, format.mintick) + " | Hedef " + str.tostring(runP, format.mintick), alert.freq_once_per_bar_close)
