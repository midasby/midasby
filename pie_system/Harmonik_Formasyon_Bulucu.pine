//@version=5
// ═══════════════════════════════════════════════════════════════════════════
//  HARMONİK FORMASYON BULUCU — C'den sonra D noktasını ÖNCEDEN çizer
//
//  Desteklenen formasyonlar (Fibonacci oranlarıyla):
//   ■ GARTLEY   : B=0.618 XA → D=0.786 XA
//   ■ BAT       : B=0.382-0.50 XA → D=0.886 XA
//   ■ BUTTERFLY : B=0.786 XA → D=1.272 XA
//   ■ CRAB      : B=0.382-0.618 XA → D=1.618 XA
//   ■ CYPHER    : C=1.13-1.414 XA → D=0.786 XC
//   ■ AB=CD     : klasik ABCD (X'siz)
//
//  NASIL ÇALIŞIR:
//  X-A-B-C pivotları kesinleşince oranlar kontrol edilir. Uyum varsa:
//   → X-A-B-C zigzag çizgileri çizilir
//   → C'den D'ye KESİKLİ projeksiyon çizgisi
//   → D bölgesine PRZ kutusu (Potansiyel Dönüş Bölgesi)
//   → Etikette: formasyon adı + D fiyatı + SL + TP1 + TP2
//   → Fiyat PRZ'ye DEĞDİĞİNDE 🎯 giriş işareti + alarm
//   → Fiyat PRZ'yi çok aşarsa formasyon iptal (gri kutu)
// ═══════════════════════════════════════════════════════════════════════════
indicator("Harmonik Formasyon Bulucu — D Projeksiyon", "HARMONIK", overlay = true,
     max_lines_count = 200, max_labels_count = 300, max_boxes_count = 50)

// ╔═══ AYARLAR ═══════════════════════════════════════════════════╗
G0 = "① Tarama"
lookN  = input.int(500, "Son kaç mum taransın?", minval = 50, maxval = 5000, group = G0)
pivLen = input.int(5, "Pivot hassasiyeti (bar)", minval = 2, maxval = 20, group = G0,
     tooltip = "Küçük = daha çok/küçük formasyon. Büyük = daha az/büyük formasyon. 4H için 5-7 idealdir")
tol    = input.float(0.08, "Oran toleransı", minval = 0.02, maxval = 0.20, step = 0.01, group = G0,
     tooltip = "0.08 = Fibonacci oranlarından %8 sapmaya izin ver")
maxPat = input.int(6, "Grafikte max formasyon", minval = 1, maxval = 15, group = G0)

G1 = "② Formasyonlar"
useGart = input.bool(true, "Gartley", group = G1)
useBat  = input.bool(true, "Bat", group = G1)
useBfly = input.bool(true, "Butterfly", group = G1)
useCrab = input.bool(true, "Crab", group = G1)
useCyph = input.bool(true, "Cypher", group = G1)
useABCD = input.bool(true, "AB=CD (X'siz klasik)", group = G1)

G2 = "③ Görünüm"
showLetters = input.bool(true, "X A B C D harflerini göster", group = G2)
showTargets = input.bool(true, "Etikette SL/TP göster", group = G2)
bullCol = input.color(#00C853, "Boğa rengi", group = G2)
bearCol = input.color(#FF1744, "Ayı rengi", group = G2)
przCol  = input.color(#AA00FF, "PRZ kutu rengi", group = G2)

// ╔═══ TEMEL ═════════════════════════════════════════════════════╗
atr   = ta.atr(14)
CONF  = barstate.isconfirmed
inWin = last_bar_index - bar_index <= lookN

// ╔═══ FORMASYON NESNESİ ═════════════════════════════════════════╗
type Harm
    int dir            // 1 = boğa (D'de ALIŞ), -1 = ayı (D'de SATIŞ)
    float przTop
    float przBot
    bool active
    line l1
    line l2
    line l3
    line l4
    box bx
    label lb
    label hx
    label ha
    label hb
    label hc

var harms = array.new<Harm>()

delHarm(Harm h) =>
    line.delete(h.l1)
    line.delete(h.l2)
    line.delete(h.l3)
    line.delete(h.l4)
    box.delete(h.bx)
    label.delete(h.lb)
    label.delete(h.hx)
    label.delete(h.ha)
    label.delete(h.hb)
    label.delete(h.hc)

// ╔═══ PİVOT ZİGZAG ══════════════════════════════════════════════╗
var pP = array.new_float()   // pivot fiyatları
var pB = array.new_int()     // pivot barları
var pH = array.new_bool()    // true = tepe pivotu

addPivot(price, bar, isH) =>
    n = array.size(pP)
    if n > 0 and array.get(pH, n - 1) == isH
        // Aynı yönde ikinci pivot: daha uç olanı tut
        lastP = array.get(pP, n - 1)
        if (isH and price > lastP) or (not isH and price < lastP)
            array.set(pP, n - 1, price)
            array.set(pB, n - 1, bar)
            true
        else
            false
    else
        array.push(pP, price)
        array.push(pB, bar)
        array.push(pH, isH)
        if array.size(pP) > 12
            array.shift(pP)
            array.shift(pB)
            array.shift(pH)
        true

ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)

changed = false
if not na(ph)
    changed := addPivot(ph, bar_index - pivLen, true) or changed
if not na(pl)
    changed := addPivot(pl, bar_index - pivLen, false) or changed

// ╔═══ ORAN YARDIMCILARI ═════════════════════════════════════════╗
inRng(v, lo, hi) => v >= lo * (1 - tol) and v <= hi * (1 + tol)

// ╔═══ FORMASYON TESPİTİ ═════════════════════════════════════════╗
var int lastCbar = -1

if changed and CONF and inWin and array.size(pP) >= 3
    n  = array.size(pP)
    cp = array.get(pP, n - 1)
    cb = array.get(pB, n - 1)
    ch = array.get(pH, n - 1)
    bp = array.get(pP, n - 2)
    bb = array.get(pB, n - 2)
    ap = array.get(pP, n - 3)
    ab_ = array.get(pB, n - 3)
    hasX = n >= 4
    xp = hasX ? array.get(pP, n - 4) : na
    xb = hasX ? array.get(pB, n - 4) : na

    if cb != lastCbar
        name = ""
        d1 = float(na)
        d2 = float(na)
        dir = 0

        // ── BOĞA: X dip, A tepe, B dip, C tepe → D dip (ALIŞ) ──
        if ch and bp < ap and cp > bp
            XA = hasX ? ap - xp : na
            AB = ap - bp
            BC = cp - bp
            if hasX and XA > 0 and AB > 0 and BC > 0
                retB = AB / XA
                retC = BC / AB
                xcR  = (cp - xp) / XA
                if useCyph and inRng(xcR, 1.13, 1.414) and inRng(retB, 0.382, 0.618)
                    name := "CYPHER"
                    d1 := cp - 0.786 * (cp - xp)
                    d2 := d1
                else if useGart and inRng(retB, 0.618, 0.618) and inRng(retC, 0.382, 0.886)
                    name := "GARTLEY"
                    d1 := ap - 0.786 * XA
                    d2 := cp - 1.272 * BC
                else if useBat and inRng(retB, 0.382, 0.50) and inRng(retC, 0.382, 0.886)
                    name := "BAT"
                    d1 := ap - 0.886 * XA
                    d2 := cp - 2.0 * BC
                else if useBfly and inRng(retB, 0.786, 0.786) and inRng(retC, 0.382, 0.886)
                    name := "BUTTERFLY"
                    d1 := ap - 1.272 * XA
                    d2 := cp - 1.618 * BC
                else if useCrab and inRng(retB, 0.382, 0.618) and inRng(retC, 0.382, 0.886)
                    name := "CRAB"
                    d1 := ap - 1.618 * XA
                    d2 := cp - 2.618 * BC
            if name == "" and useABCD and AB > 0 and BC > 0 and inRng(BC / AB, 0.382, 0.886)
                name := "AB=CD"
                d1 := cp - AB
                d2 := cp - 1.272 * AB
            if name != "" and math.min(d1, d2) > 0
                dir := 1

        // ── AYI: X tepe, A dip, B tepe, C dip → D tepe (SATIŞ) ──
        if not ch and bp > ap and cp < bp
            XA = hasX ? xp - ap : na
            AB = bp - ap
            BC = bp - cp
            if hasX and XA > 0 and AB > 0 and BC > 0
                retB = AB / XA
                retC = BC / AB
                xcR  = (xp - cp) / XA
                if useCyph and inRng(xcR, 1.13, 1.414) and inRng(retB, 0.382, 0.618)
                    name := "CYPHER"
                    d1 := cp + 0.786 * (xp - cp)
                    d2 := d1
                else if useGart and inRng(retB, 0.618, 0.618) and inRng(retC, 0.382, 0.886)
                    name := "GARTLEY"
                    d1 := ap + 0.786 * XA
                    d2 := cp + 1.272 * BC
                else if useBat and inRng(retB, 0.382, 0.50) and inRng(retC, 0.382, 0.886)
                    name := "BAT"
                    d1 := ap + 0.886 * XA
                    d2 := cp + 2.0 * BC
                else if useBfly and inRng(retB, 0.786, 0.786) and inRng(retC, 0.382, 0.886)
                    name := "BUTTERFLY"
                    d1 := ap + 1.272 * XA
                    d2 := cp + 1.618 * BC
                else if useCrab and inRng(retB, 0.382, 0.618) and inRng(retC, 0.382, 0.886)
                    name := "CRAB"
                    d1 := ap + 1.618 * XA
                    d2 := cp + 2.618 * BC
            if name == "" and useABCD and AB > 0 and BC > 0 and inRng(BC / AB, 0.382, 0.886)
                name := "AB=CD"
                d1 := cp + AB
                d2 := cp + 1.272 * AB
            if name != ""
                dir := -1

        // ── ÇİZİM ──────────────────────────────────────────────
        if dir != 0
            lastCbar := cb
            mainCol  = dir == 1 ? bullCol : bearCol
            przT = math.max(d1, d2)
            przB = math.min(d1, d2)
            // PRZ çok inceyse ATR kadar genişlet
            if przT - przB < atr * 0.3
                przT := przT + atr * 0.15
                przB := przB - atr * 0.15
            estBars = math.max(8, cb - bb)
            dBar = cb + estBars
            dMid = (przT + przB) / 2

            ln1 = hasX ? line.new(xb, xp, ab_, ap, color = mainCol, width = 2) : line.new(ab_, ap, ab_, ap, color = mainCol)
            ln2 = line.new(ab_, ap, bb, bp, color = mainCol, width = 2)
            ln3 = line.new(bb, bp, cb, cp, color = mainCol, width = 2)
            ln4 = line.new(cb, cp, dBar, dMid, color = przCol, width = 2, style = line.style_dashed)
            bx1 = box.new(cb + 1, przT, dBar + 12, przB, border_color = przCol, border_width = 2, bgcolor = color.new(przCol, 85), text = "PRZ — D BÖLGESİ", text_color = przCol, text_size = size.tiny)

            slP  = dir == 1 ? przB - atr * 0.8 : przT + atr * 0.8
            tp1P = dir == 1 ? dMid + 0.382 * (ap - dMid) : dMid - 0.382 * (dMid - ap)
            tp2P = dir == 1 ? dMid + 0.618 * (ap - dMid) : dMid - 0.618 * (dMid - ap)
            tgt  = showTargets ? "\nSL  " + str.tostring(slP, format.mintick) + "\nTP1 " + str.tostring(tp1P, format.mintick) + "\nTP2 " + str.tostring(tp2P, format.mintick) : ""
            lbTxt = name + (dir == 1 ? "  ▲ ALIŞ" : "  ▼ SATIŞ") + "\nD: " + str.tostring(dMid, format.mintick) + tgt
            lb1 = label.new(dBar, dMid, lbTxt, style = dir == 1 ? label.style_label_up : label.style_label_down, color = color.new(mainCol, 10), textcolor = color.white, size = size.small)

            lxL = showLetters and hasX ? label.new(xb, xp, "X", style = ch ? label.style_label_up : label.style_label_down, color = color.new(mainCol, 30), textcolor = color.white, size = size.tiny) : label.new(ab_, ap, "", color = color.new(color.white, 100))
            laL = showLetters ? label.new(ab_, ap, "A", style = ch ? label.style_label_down : label.style_label_up, color = color.new(mainCol, 30), textcolor = color.white, size = size.tiny) : label.new(ab_, ap, "", color = color.new(color.white, 100))
            lbL = showLetters ? label.new(bb, bp, "B", style = ch ? label.style_label_up : label.style_label_down, color = color.new(mainCol, 30), textcolor = color.white, size = size.tiny) : label.new(bb, bp, "", color = color.new(color.white, 100))
            lcL = showLetters ? label.new(cb, cp, "C", style = ch ? label.style_label_down : label.style_label_up, color = color.new(mainCol, 30), textcolor = color.white, size = size.tiny) : label.new(cb, cp, "", color = color.new(color.white, 100))

            array.push(harms, Harm.new(dir, przT, przB, true, ln1, ln2, ln3, ln4, bx1, lb1, lxL, laL, lbL, lcL))
            if array.size(harms) > maxPat
                old = array.shift(harms)
                delHarm(old)

// ╔═══ PRZ TEMAS & İPTAL KONTROLÜ ════════════════════════════════╗
przHitBull = false
przHitBear = false
if CONF and array.size(harms) > 0
    for i = 0 to array.size(harms) - 1
        h = array.get(harms, i)
        if h.active
            zoneW = h.przTop - h.przBot
            if h.dir == 1
                if low <= h.przTop and high >= h.przBot
                    przHitBull := true
                    h.active := false
                    box.set_bgcolor(h.bx, color.new(bullCol, 70))
                    label.new(bar_index, low - atr * 0.5, "🎯 D NOKTASI\n▲ ALIŞ BÖLGESİ", style = label.style_label_up, color = color.new(bullCol, 0), textcolor = color.white, size = size.normal)
                else if close < h.przBot - zoneW * 1.5
                    h.active := false
                    box.set_bgcolor(h.bx, color.new(color.gray, 90))
                    box.set_border_color(h.bx, color.new(color.gray, 60))
                    box.set_text(h.bx, "İPTAL")
            else
                if high >= h.przBot and low <= h.przTop
                    przHitBear := true
                    h.active := false
                    box.set_bgcolor(h.bx, color.new(bearCol, 70))
                    label.new(bar_index, high + atr * 0.5, "🎯 D NOKTASI\n▼ SATIŞ BÖLGESİ", style = label.style_label_down, color = color.new(bearCol, 0), textcolor = color.white, size = size.normal)
                else if close > h.przTop + zoneW * 1.5
                    h.active := false
                    box.set_bgcolor(h.bx, color.new(color.gray, 90))
                    box.set_border_color(h.bx, color.new(color.gray, 60))
                    box.set_text(h.bx, "İPTAL")

// ╔═══ BİLGİ PANELİ ══════════════════════════════════════════════╗
var table pnl = table.new(position.top_right, 2, 3, frame_color = color.new(przCol, 0), frame_width = 1, border_color = color.new(color.gray, 70), border_width = 1)
if barstate.islast
    activeCnt = 0
    if array.size(harms) > 0
        for i = 0 to array.size(harms) - 1
            h = array.get(harms, i)
            activeCnt += h.active ? 1 : 0
    bgC = color.new(color.black, 45)
    table.cell(pnl, 0, 0, "HARMONİK", text_color = przCol, bgcolor = color.new(color.black, 20), text_size = size.small)
    table.cell(pnl, 1, 0, "D Projeksiyon", text_color = przCol, bgcolor = color.new(color.black, 20), text_size = size.tiny)
    table.cell(pnl, 0, 1, "Bekleyen D", text_color = color.silver, bgcolor = bgC, text_size = size.tiny)
    table.cell(pnl, 1, 1, str.tostring(activeCnt) + " formasyon", text_color = activeCnt > 0 ? color.yellow : color.gray, bgcolor = bgC, text_size = size.tiny)
    table.cell(pnl, 0, 2, "Toplam çizili", text_color = color.silver, bgcolor = bgC, text_size = size.tiny)
    table.cell(pnl, 1, 2, str.tostring(array.size(harms)), text_color = color.white, bgcolor = bgC, text_size = size.tiny)

// ╔═══ ALARMLAR ══════════════════════════════════════════════════╗
alertcondition(przHitBull, "HARMONİK — D ALIŞ", "Harmonik: Fiyat D noktasına (PRZ) ulaştı — ALIŞ bölgesi! Tepki mumunu bekle.")
alertcondition(przHitBear, "HARMONİK — D SATIŞ", "Harmonik: Fiyat D noktasına (PRZ) ulaştı — SATIŞ bölgesi! Tepki mumunu bekle.")
alertcondition(przHitBull or przHitBear, "HARMONİK — D Noktası", "Harmonik: Fiyat D noktasına ulaştı!")
