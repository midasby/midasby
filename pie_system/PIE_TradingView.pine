//@version=5
// ════════════════════════════════════════════════════════════════
//  PIE ANALİZ SİSTEMİ — Para Sihirbazı (Price Is Everything)
//  Mum çubukları ile fiyat analizi — İndikatörsüz, sadece fiyat!
//
//  İçerik:
//   • Momentum mumları
//   • PinBar (Bullish/Bearish)
//   • Engulf + Sihirli Engulf
//   • Bobin (kümelenme/karar bölgesi)
//   • Supdem (Arz-Talep) bölgeleri — otomatik kutu çizimi
//   • At Nalı formasyonu
//   • Ying Yang formasyonu
//   • Trend tespiti (HH/HL — LH/LL)
//   • Çoklu teyit puanlama (1-5 yıldız)
//   • Alarm desteği
// ════════════════════════════════════════════════════════════════
indicator("PIE Analiz Sistemi — Para Sihirbazı", "PIE", overlay = true, max_boxes_count = 100, max_labels_count = 200, max_lines_count = 50)

// ─── AYARLAR ─────────────────────────────────────────────────────
grpGenel    = "Genel"
showMom     = input.bool(true,  "Momentum Mumları",          group = grpGenel)
showPin     = input.bool(true,  "PinBar Sinyalleri",         group = grpGenel)
showEng     = input.bool(true,  "Engulf Sinyalleri",         group = grpGenel)
showMagic   = input.bool(true,  "Sihirli Engulf",            group = grpGenel)
showAtNali  = input.bool(true,  "At Nalı Formasyonu",        group = grpGenel)
showYY      = input.bool(true,  "Ying Yang Formasyonu",      group = grpGenel)
showZones   = input.bool(true,  "Supdem (Arz-Talep) Bölgeleri", group = grpGenel)
showTrend   = input.bool(true,  "Trend Paneli",              group = grpGenel)

grpFiltre   = "Filtreler"
minScore    = input.int(3, "Minimum Yıldız (teyit) Sayısı", minval = 1, maxval = 5, group = grpFiltre, tooltip = "PDF: 'En az 2, daha iyisi 3 teyit alınmalı'")
trendFilter = input.bool(true, "Sadece Trend Yönünde Sinyal", group = grpFiltre, tooltip = "PDF: 'Trendin tersine işlem açmamak gerekir'")

grpParam    = "Parametreler"
momMult     = input.float(1.5, "Momentum Çarpanı",   minval = 1.0, step = 0.1, group = grpParam)
pinRatio    = input.float(2.0, "PinBar İğne/Gövde Oranı", minval = 1.5, step = 0.1, group = grpParam)
zoneBars    = input.int(150, "Bölge Ömrü (bar)",     minval = 20,  group = grpParam)
maxTests    = input.int(3,   "Bölge Max Test Sayısı", minval = 1, maxval = 6, group = grpParam, tooltip = "PDF: 'İkiden fazla denendiğinde zayıflamaya başlar'")

// ─── TEMEL HESAPLAR ──────────────────────────────────────────────
body      = math.abs(close - open)
rng       = high - low
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
isBull    = close > open
isBear    = close < open

avgBody   = ta.sma(body, 20)
avgRange  = ta.sma(rng, 20)
atr       = ta.atr(14)

// ─── MOMENTUM ────────────────────────────────────────────────────
// PDF: "büyük, diğerlerinden daha uzun olan mum çubuklardır"
isMomentum = body > avgBody * momMult or rng > avgRange * momMult

// ─── TREND TESPİTİ (HH/HL vs LH/LL) ──────────────────────────────
pivHi = ta.pivothigh(high, 5, 5)
pivLo = ta.pivotlow(low, 5, 5)

var float lastHi  = na
var float prevHi  = na
var float lastLo  = na
var float prevLo  = na

if not na(pivHi)
    prevHi := lastHi
    lastHi := pivHi
if not na(pivLo)
    prevLo := lastLo
    lastLo := pivLo

trendBullScore = 0
trendBullScore += not na(lastHi) and not na(prevHi) and lastHi > prevHi ? 1 : 0
trendBullScore += not na(lastLo) and not na(prevLo) and lastLo > prevLo ? 1 : 0
trendBullScore += close > ta.sma(close, 30) ? 1 : 0

trendBearScore = 0
trendBearScore += not na(lastHi) and not na(prevHi) and lastHi < prevHi ? 1 : 0
trendBearScore += not na(lastLo) and not na(prevLo) and lastLo < prevLo ? 1 : 0
trendBearScore += close < ta.sma(close, 30) ? 1 : 0

trendDir = trendBullScore > trendBearScore ? 1 : trendBearScore > trendBullScore ? -1 : 0

// ─── PİNBAR ──────────────────────────────────────────────────────
// PDF: "iğnesi uzun, gövdesi çok kısa olan barlardır"
smallBody = body < rng * 0.35
bullPin = smallBody and lowerWick > body * pinRatio and lowerWick > upperWick * 2 and lowerWick > rng * 0.5
bearPin = smallBody and upperWick > body * pinRatio and upperWick > lowerWick * 2 and upperWick > rng * 0.5

// ─── ENGULF ──────────────────────────────────────────────────────
bullEngulf = isBear[1] and isBull and body > body[1] * 1.05 and close > open[1] and open <= close[1]
bearEngulf = isBull[1] and isBear and body > body[1] * 1.05 and close < open[1] and open >= close[1]

// ─── SİHİRLİ ENGULF ──────────────────────────────────────────────
// PDF: "iğnelerin yönü ikinci barın yönündedir"
bullMagicEng = bullEngulf and upperWick > body * 0.25 and lowerWick[1] > body[1] * 0.4
bearMagicEng = bearEngulf and lowerWick > body * 0.25 and upperWick[1] > body[1] * 0.4

// ─── AT NALI ─────────────────────────────────────────────────────
// PDF: "4 mum; kenardakiler ortadakilerden net uzun. Y-D-Y-D = SAT, D-Y-D-Y = AL"
outerMin   = math.min(body[3], body)
innerMax   = math.max(body[2], body[1])
atNaliOk   = outerMin > innerMax * 1.1
atNaliSell = atNaliOk and isBull[3] and isBear[2] and isBull[1] and isBear
atNaliBuy  = atNaliOk and isBear[3] and isBull[2] and isBear[1] and isBull

// ─── YİNG YANG ───────────────────────────────────────────────────
// PDF: "iki düşen mum; 1.si uzun alt iğne, 2.si uzun üst iğne"
minWick = atr * 0.3
yySell = isBear[1] and isBear and lowerWick[1] > minWick and upperWick[1] < lowerWick[1] * 0.4 and upperWick > minWick and lowerWick < upperWick * 0.4
yyBuy  = isBull[1] and isBull and upperWick[1] > minWick and lowerWick[1] < upperWick[1] * 0.4 and lowerWick > minWick and upperWick < lowerWick * 0.4

// ─── SUPDEM BÖLGELERİ (kutu çizimi) ──────────────────────────────
// PDF: "Engulf oluşumunun yalnız birinci mumundan dikdörtgen çizilir"
var demandBoxes = array.new_box()
var supplyBoxes = array.new_box()
var demandTests = array.new_int()
var supplyTests = array.new_int()

colDemand     = color.new(color.green, 82)
colSupply     = color.new(color.red, 82)
colDemandWeak = color.new(color.gray, 90)
colSupplyWeak = color.new(color.gray, 90)

if showZones and bullEngulf
    b = box.new(bar_index - 1, high[1] + atr * 0.1, bar_index + zoneBars, low[1] - atr * 0.1, border_color = color.new(color.green, 50), bgcolor = colDemand, text = "TALEP", text_color = color.new(color.green, 30), text_size = size.tiny, text_halign = text.align_right)
    array.push(demandBoxes, b)
    array.push(demandTests, 0)

if showZones and bearEngulf
    b = box.new(bar_index - 1, high[1] + atr * 0.1, bar_index + zoneBars, low[1] - atr * 0.1, border_color = color.new(color.red, 50), bgcolor = colSupply, text = "ARZ", text_color = color.new(color.red, 30), text_size = size.tiny, text_halign = text.align_right)
    array.push(supplyBoxes, b)
    array.push(supplyTests, 0)

// Bölge test sayımı ve temizlik
// PDF: "İkiden fazla denendiğinde zayıflamaya başlar"
if array.size(demandBoxes) > 0
    for i = array.size(demandBoxes) - 1 to 0
        b = array.get(demandBoxes, i)
        t = box.get_top(b)
        btm = box.get_bottom(b)
        if bar_index > box.get_left(b) + 2 and low <= t and high >= btm
            tests = array.get(demandTests, i) + 1
            array.set(demandTests, i, tests)
            if tests > maxTests or close < btm - atr
                box.set_bgcolor(b, colDemandWeak)
                box.set_right(b, bar_index)
                array.remove(demandBoxes, i)
                array.remove(demandTests, i)

if array.size(supplyBoxes) > 0
    for i = array.size(supplyBoxes) - 1 to 0
        b = array.get(supplyBoxes, i)
        t = box.get_top(b)
        btm = box.get_bottom(b)
        if bar_index > box.get_left(b) + 2 and high >= btm and low <= t
            tests = array.get(supplyTests, i) + 1
            array.set(supplyTests, i, tests)
            if tests > maxTests or close > t + atr
                box.set_bgcolor(b, colSupplyWeak)
                box.set_right(b, bar_index)
                array.remove(supplyBoxes, i)
                array.remove(supplyTests, i)

// Fiyat aktif bölgede mi?
inDemandZone = false
if array.size(demandBoxes) > 0
    for i = 0 to array.size(demandBoxes) - 1
        b = array.get(demandBoxes, i)
        if close <= box.get_top(b) + atr * 0.3 and close >= box.get_bottom(b) - atr * 0.3
            inDemandZone := true

inSupplyZone = false
if array.size(supplyBoxes) > 0
    for i = 0 to array.size(supplyBoxes) - 1
        b = array.get(supplyBoxes, i)
        if close <= box.get_top(b) + atr * 0.3 and close >= box.get_bottom(b) - atr * 0.3
            inSupplyZone := true

// ─── PUANLAMA (TEYİT SİSTEMİ) ────────────────────────────────────
// PDF: Trend + Momentum + Supdem + Formasyon = stratejik karar
score(dir) =>
    s = 1  // temel formasyon
    s += (dir == 1 and trendDir == 1) or (dir == -1 and trendDir == -1) ? 1 : 0
    s += isMomentum or isMomentum[1] ? 1 : 0
    s += (dir == 1 and inDemandZone) or (dir == -1 and inSupplyZone) ? 1 : 0
    math.min(s, 5)

stars(s) =>
    s == 5 ? "★★★★★" : s == 4 ? "★★★★" : s == 3 ? "★★★" : s == 2 ? "★★" : "★"

trendOk(dir) => not trendFilter or trendDir == 0 or (dir == 1 and trendDir == 1) or (dir == -1 and trendDir == -1)

// ─── SİNYAL ÇİZİMİ ───────────────────────────────────────────────
// PinBar
buyPinScore  = bullPin ? score(1)  : 0
sellPinScore = bearPin ? score(-1) : 0
plotPinBuy   = showPin and bullPin and buyPinScore  >= minScore and trendOk(1)
plotPinSell  = showPin and bearPin and sellPinScore >= minScore and trendOk(-1)

if plotPinBuy
    label.new(bar_index, low - atr * 0.3, "PIN AL\n" + stars(buyPinScore), style = label.style_label_up, color = color.new(color.green, 15), textcolor = color.white, size = size.small)
if plotPinSell
    label.new(bar_index, high + atr * 0.3, "PIN SAT\n" + stars(sellPinScore), style = label.style_label_down, color = color.new(color.red, 15), textcolor = color.white, size = size.small)

// Sihirli Engulf
buyMagicScore  = bullMagicEng ? score(1)  : 0
sellMagicScore = bearMagicEng ? score(-1) : 0
plotMagicBuy   = showMagic and bullMagicEng and buyMagicScore  >= minScore and trendOk(1)
plotMagicSell  = showMagic and bearMagicEng and sellMagicScore >= minScore and trendOk(-1)

if plotMagicBuy
    label.new(bar_index, low - atr * 0.3, "SİHİRLİ ENG AL\n" + stars(buyMagicScore), style = label.style_label_up, color = color.new(color.teal, 10), textcolor = color.white, size = size.small)
if plotMagicSell
    label.new(bar_index, high + atr * 0.3, "SİHİRLİ ENG SAT\n" + stars(sellMagicScore), style = label.style_label_down, color = color.new(color.maroon, 10), textcolor = color.white, size = size.small)

// Normal Engulf (sadece Supdem bölgesinde — PDF kuralı)
plotEngBuy  = showEng and bullEngulf and not bullMagicEng and inDemandZone and score(1)  >= minScore and trendOk(1)
plotEngSell = showEng and bearEngulf and not bearMagicEng and inSupplyZone and score(-1) >= minScore and trendOk(-1)

if plotEngBuy
    label.new(bar_index, low - atr * 0.3, "ENG AL\n" + stars(score(1)), style = label.style_label_up, color = color.new(color.green, 35), textcolor = color.white, size = size.tiny)
if plotEngSell
    label.new(bar_index, high + atr * 0.3, "ENG SAT\n" + stars(score(-1)), style = label.style_label_down, color = color.new(color.red, 35), textcolor = color.white, size = size.tiny)

// At Nalı
plotNalBuy  = showAtNali and atNaliBuy  and score(1)  >= minScore and trendOk(1)
plotNalSell = showAtNali and atNaliSell and score(-1) >= minScore and trendOk(-1)

if plotNalBuy
    label.new(bar_index, low - atr * 0.5, "AT NALI AL\n" + stars(score(1)), style = label.style_label_up, color = color.new(color.blue, 15), textcolor = color.white, size = size.small)
if plotNalSell
    label.new(bar_index, high + atr * 0.5, "AT NALI SAT\n" + stars(score(-1)), style = label.style_label_down, color = color.new(color.orange, 15), textcolor = color.white, size = size.small)

// Ying Yang (SL/TP ile)
plotYYBuy  = showYY and yyBuy  and score(1)  >= minScore and trendOk(1)
plotYYSell = showYY and yySell and score(-1) >= minScore and trendOk(-1)

if plotYYBuy
    slLvl = low[1] - atr * 0.1
    tpLvl = close + body + body[1]
    label.new(bar_index, low - atr * 0.5, "YING YANG AL\n" + stars(score(1)) + "\nSL: " + str.tostring(slLvl, format.mintick) + "\nTP: " + str.tostring(tpLvl, format.mintick), style = label.style_label_up, color = color.new(color.purple, 15), textcolor = color.white, size = size.small)
if plotYYSell
    slLvl = high[1] + atr * 0.1
    tpLvl = close - body - body[1]
    label.new(bar_index, high + atr * 0.5, "YING YANG SAT\n" + stars(score(-1)) + "\nSL: " + str.tostring(slLvl, format.mintick) + "\nTP: " + str.tostring(tpLvl, format.mintick), style = label.style_label_down, color = color.new(color.purple, 15), textcolor = color.white, size = size.small)

// ─── MOMENTUM RENKLENDİRME ───────────────────────────────────────
barcolor(showMom and isMomentum ? (isBull ? color.new(color.lime, 0) : color.new(color.fuchsia, 0)) : na)

// ─── TREND PANELİ ────────────────────────────────────────────────
var table panel = table.new(position.top_right, 2, 4, border_width = 1)
if barstate.islast and showTrend
    trendTxt  = trendDir == 1 ? "▲ YÜKSELİŞ" : trendDir == -1 ? "▼ DÜŞÜŞ" : "─ YATAY"
    trendCol  = trendDir == 1 ? color.green : trendDir == -1 ? color.red : color.gray
    momTxt    = isMomentum ? "GÜÇLÜ" : "ZAYIF"
    zoneTxt   = inDemandZone ? "TALEP BÖLGESİNDE" : inSupplyZone ? "ARZ BÖLGESİNDE" : "Bölge dışı"

    table.cell(panel, 0, 0, "PIE SİSTEMİ", text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.small)
    table.cell(panel, 1, 0, "Para Sihirbazı", text_color = color.yellow, bgcolor = color.new(color.black, 20), text_size = size.small)
    table.cell(panel, 0, 1, "Trend", text_color = color.white, bgcolor = color.new(color.black, 40), text_size = size.small)
    table.cell(panel, 1, 1, trendTxt, text_color = trendCol, bgcolor = color.new(color.black, 40), text_size = size.small)
    table.cell(panel, 0, 2, "Momentum", text_color = color.white, bgcolor = color.new(color.black, 40), text_size = size.small)
    table.cell(panel, 1, 2, momTxt, text_color = isMomentum ? color.lime : color.gray, bgcolor = color.new(color.black, 40), text_size = size.small)
    table.cell(panel, 0, 3, "Supdem", text_color = color.white, bgcolor = color.new(color.black, 40), text_size = size.small)
    table.cell(panel, 1, 3, zoneTxt, text_color = inDemandZone ? color.green : inSupplyZone ? color.red : color.gray, bgcolor = color.new(color.black, 40), text_size = size.small)

// ─── ALARMLAR ────────────────────────────────────────────────────
anyBuy  = plotPinBuy  or plotMagicBuy  or plotEngBuy  or plotNalBuy  or plotYYBuy
anySell = plotPinSell or plotMagicSell or plotEngSell or plotNalSell or plotYYSell

alertcondition(anyBuy,  "PIE ALIŞ Sinyali",  "PIE: ALIŞ sinyali oluştu! Teyitleri kontrol et, R/R hesapla.")
alertcondition(anySell, "PIE SATIŞ Sinyali", "PIE: SATIŞ sinyali oluştu! Teyitleri kontrol et, R/R hesapla.")
alertcondition(anyBuy or anySell, "PIE Herhangi Bir Sinyal", "PIE: Yeni sinyal oluştu!")
