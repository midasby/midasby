//@version=5
// ════════════════════════════════════════════════════════════════
//  PIE ANALİZ SİSTEMİ — Para Sihirbazı (Price Is Everything)
//  v2 — Mumlarla birlikte hareket eder, yeniden çizme sorunu yok
// ════════════════════════════════════════════════════════════════
indicator("PIE Analiz Sistemi — Para Sihirbazı", "PIE v2", overlay = true,
          max_boxes_count = 200, max_labels_count = 300, max_lines_count = 50)

// ─── AYARLAR ─────────────────────────────────────────────────────
G1 = "Göster / Gizle"
showMom    = input.bool(true,  "Momentum Mumları (Renk)",    group = G1)
showPin    = input.bool(true,  "PinBar",                     group = G1)
showEng    = input.bool(true,  "Engulf",                     group = G1)
showMagic  = input.bool(true,  "Sihirli Engulf",             group = G1)
showNali   = input.bool(true,  "At Nalı",                    group = G1)
showYY     = input.bool(true,  "Ying Yang",                  group = G1)
showZones  = input.bool(true,  "Supdem (Arz/Talep) Kutuları",group = G1)
showPanel  = input.bool(true,  "Bilgi Paneli (sağ üst)",     group = G1)

G2 = "Parametreler"
momMult    = input.float(1.5,  "Momentum çarpanı",  step = 0.1, minval = 1.0, group = G2)
pinRatio   = input.float(2.0,  "PinBar iğne/gövde", step = 0.1, minval = 1.5, group = G2)
zoneBars   = input.int(80,     "Kutu genişliği (bar)",       minval = 10, group = G2)

G3 = "Sinyal Filtresi"
minScore   = input.int(2,      "Min. teyit sayısı (1-5 yıldız)", minval = 1, maxval = 5, group = G3)
trendFlt   = input.bool(true,  "Sadece trend yönünde sinyal", group = G3)

// ─── TEMEL ───────────────────────────────────────────────────────
body      = math.abs(close - open)
rng       = high - low
upWick    = high - math.max(open, close)
dnWick    = math.min(open, close) - low
isBull    = close > open
isBear    = close < open
avgBody   = ta.sma(body, 20)
avgRng    = ta.sma(rng, 20)
atr       = ta.atr(14)

// ─── MOMENTUM ────────────────────────────────────────────────────
isMom = body > avgBody * momMult or rng > avgRng * momMult
barcolor(showMom and isMom and isBull ? color.new(color.lime, 20)    : na, title = "Yükselen Momentum")
barcolor(showMom and isMom and isBear ? color.new(color.fuchsia, 20) : na, title = "Düşen Momentum")

// ─── TREND (HH/HL — LH/LL) ───────────────────────────────────────
ph = ta.pivothigh(high, 5, 5)
pl = ta.pivotlow (low,  5, 5)
var float hi1 = na, var float hi2 = na
var float lo1 = na, var float lo2 = na
if not na(ph)
    hi2 := hi1
    hi1 := ph
if not na(pl)
    lo2 := lo1
    lo1 := pl
isUptrend  = not na(hi1) and not na(hi2) and not na(lo1) and not na(lo2) and hi1 > hi2 and lo1 > lo2
isDowntrend= not na(hi1) and not na(hi2) and not na(lo1) and not na(lo2) and hi1 < hi2 and lo1 < lo2
trendDir   = isUptrend ? 1 : isDowntrend ? -1 : 0

// ─── PİNBAR ──────────────────────────────────────────────────────
// PDF: "iğnesi uzun, gövdesi çok kısa; önemli bölgelerde oluşanlara itibar edilir"
smallBody = body < rng * 0.35 and rng > 0
bullPin   = smallBody and dnWick > body * pinRatio and dnWick > upWick * 2 and dnWick > rng * 0.5
bearPin   = smallBody and upWick > body * pinRatio and upWick > dnWick * 2 and upWick > rng * 0.5

// ─── ENGULF ──────────────────────────────────────────────────────
// PDF: "bir bardan sonra daha uzun zıt bar"
bullEng   = isBear[1] and isBull and body > body[1] * 1.05 and close > open[1] and open <= close[1]
bearEng   = isBull[1] and isBear and body > body[1] * 1.05 and close < open[1] and open >= close[1]

// ─── SİHİRLİ ENGULF ──────────────────────────────────────────────
// PDF: "iğnelerin yönü ikinci barın yönündedir"
bullMagic = bullEng and upWick > body * 0.2 and dnWick[1] > body[1] * 0.35
bearMagic = bearEng and dnWick > body * 0.2 and upWick[1] > body[1] * 0.35

// ─── AT NALI ─────────────────────────────────────────────────────
// PDF: "4 mum; kenardakiler ortadakilerden NET uzun. Y-D-Y-D=SAT  D-Y-D-Y=AL"
naliOk    = math.min(body, body[3]) > math.max(body[1], body[2]) * 1.1
atNaliBuy = naliOk and isBear[3] and isBull[2] and isBear[1] and isBull
atNaliSel = naliOk and isBull[3] and isBear[2] and isBull[1] and isBear

// ─── YİNG YANG ───────────────────────────────────────────────────
// PDF: "iki aynı yönlü mum; biri alt-iğneli diğeri üst-iğneli"
minYY  = atr * 0.3
yyBuy  = isBull[1] and isBull and upWick[1] > minYY and dnWick[1] < upWick[1]*0.4 and dnWick > minYY and upWick < dnWick*0.4
yySell = isBear[1] and isBear and dnWick[1] > minYY and upWick[1] < dnWick[1]*0.4 and upWick > minYY and dnWick < upWick*0.4

// ─── PUANLAMA (1-5 YILDIZ) ────────────────────────────────────────
// PDF: "Trend + Korelasyon + Momentum + Mum çubuklar = stratejik karar"
calcScore(dir) =>
    s = 1
    s += (dir ==  1 and trendDir ==  1) or (dir == -1 and trendDir == -1) ? 1 : 0
    s += isMom or isMom[1] ? 1 : 0
    s += dir ==  1 and (bullEng[1] or bullEng[2] or bullPin[1] or bullPin[2]) ? 1 : 0
    s += dir == -1 and (bearEng[1] or bearEng[2] or bearPin[1] or bearPin[2]) ? 1 : 0
    math.min(s, 5)

stars(n) => n == 5 ? "★★★★★" : n == 4 ? "★★★★☆" : n == 3 ? "★★★☆☆" : n == 2 ? "★★☆☆☆" : "★☆☆☆☆"

trendOk(dir) =>
    not trendFlt or trendDir == 0 or (dir == 1 and trendDir == 1) or (dir == -1 and trendDir == -1)

// ─── SUPDEM KUTULARI — box.new() doğrudan, array yok ─────────────
// Bu yöntemde kutular her zaman mumlarla birlikte hareket eder
// PDF: "Engulf oluşumunun yalnız birinci mumundan dikdörtgen çizilir"
if showZones
    // Demand (Talep) — bullish engulf'ın birinci mumu
    if bullEng
        box.new(bar_index[1], high[1], bar_index + zoneBars, low[1],
                border_color = color.new(color.green, 30),
                border_width = 1,
                bgcolor      = color.new(color.green, 88),
                text         = "TALEP",
                text_color   = color.new(color.green, 20),
                text_size    = size.tiny,
                text_halign  = text.align_right)

    // Supply (Arz) — bearish engulf'ın birinci mumu
    if bearEng
        box.new(bar_index[1], high[1], bar_index + zoneBars, low[1],
                border_color = color.new(color.red, 30),
                border_width = 1,
                bgcolor      = color.new(color.red, 88),
                text         = "ARZ",
                text_color   = color.new(color.red, 20),
                text_size    = size.tiny,
                text_halign  = text.align_right)

    // Sihirli Demand — daha kalın kenarlık
    if bullMagic
        box.new(bar_index[1], high[1], bar_index + zoneBars, low[1],
                border_color = color.new(color.lime, 0),
                border_width = 2,
                bgcolor      = color.new(color.lime, 82),
                text         = "✦TALEP",
                text_color   = color.new(color.lime, 0),
                text_size    = size.tiny,
                text_halign  = text.align_right)

    // Sihirli Supply
    if bearMagic
        box.new(bar_index[1], high[1], bar_index + zoneBars, low[1],
                border_color = color.new(color.orange, 0),
                border_width = 2,
                bgcolor      = color.new(color.orange, 82),
                text         = "✦ARZ",
                text_color   = color.new(color.orange, 0),
                text_size    = size.tiny,
                text_halign  = text.align_right)

// ─── SİNYAL ETİKETLERİ ───────────────────────────────────────────
// plotshape ile de çiziyoruz — bunlar HER ZAMAN mumlarla birlikte
// ── PinBar ──
pinBuyShow  = showPin and bullPin  and calcScore(1)  >= minScore and trendOk(1)
pinSelShow  = showPin and bearPin  and calcScore(-1) >= minScore and trendOk(-1)

plotshape(pinBuyShow,  title="PinBar AL",  style = shape.triangleup,   location = location.belowbar, color = color.new(color.green, 10), size = size.small)
plotshape(pinSelShow,  title="PinBar SAT", style = shape.triangledown,  location = location.abovebar, color = color.new(color.red, 10),   size = size.small)

if pinBuyShow
    label.new(bar_index, low - atr, "PIN AL\n" + stars(calcScore(1)),
              style = label.style_label_up, color = color.new(color.green, 10),
              textcolor = color.white, size = size.small)
if pinSelShow
    label.new(bar_index, high + atr, "PIN SAT\n" + stars(calcScore(-1)),
              style = label.style_label_down, color = color.new(color.red, 10),
              textcolor = color.white, size = size.small)

// ── Sihirli Engulf ──
magBuyShow = showMagic and bullMagic and calcScore(1)  >= minScore and trendOk(1)
magSelShow = showMagic and bearMagic and calcScore(-1) >= minScore and trendOk(-1)

plotshape(magBuyShow, title="Sihirli Eng AL",  style = shape.labelup,   location = location.belowbar, color = color.new(color.teal, 5),    textcolor = color.white, size = size.small, text = "✦ENG")
plotshape(magSelShow, title="Sihirli Eng SAT", style = shape.labeldown, location = location.abovebar, color = color.new(color.maroon, 5),  textcolor = color.white, size = size.small, text = "✦ENG")

// ── Normal Engulf (sadece bölge içinde anlamlı) ──
engBuyShow = showEng and bullEng and not bullMagic and calcScore(1)  >= minScore and trendOk(1)
engSelShow = showEng and bearEng and not bearMagic and calcScore(-1) >= minScore and trendOk(-1)

plotshape(engBuyShow, title="Engulf AL",  style = shape.arrowup,   location = location.belowbar, color = color.new(color.green, 30), size = size.tiny)
plotshape(engSelShow, title="Engulf SAT", style = shape.arrowdown, location = location.abovebar, color = color.new(color.red, 30),   size = size.tiny)

// ── At Nalı ──
nalBuyShow = showNali and atNaliBuy and calcScore(1)  >= minScore and trendOk(1)
nalSelShow = showNali and atNaliSel and calcScore(-1) >= minScore and trendOk(-1)

plotshape(nalBuyShow, title="At Nalı AL",  style = shape.labelup,   location = location.belowbar, color = color.new(color.blue, 5),   textcolor = color.white, size = size.normal, text = "🧲AL")
plotshape(nalSelShow, title="At Nalı SAT", style = shape.labeldown, location = location.abovebar, color = color.new(color.orange, 5), textcolor = color.white, size = size.normal, text = "🧲SAT")

// ── Ying Yang ──
yyBuyShow = showYY and yyBuy  and calcScore(1)  >= minScore and trendOk(1)
yySelShow = showYY and yySell and calcScore(-1) >= minScore and trendOk(-1)

if yyBuyShow
    label.new(bar_index, low - atr * 1.2,
              "☯ ALIŞ\n" + stars(calcScore(1)) + "\nSL:" + str.tostring(low[1] - atr * 0.2, format.mintick),
              style = label.style_label_up, color = color.new(color.purple, 10),
              textcolor = color.white, size = size.small)
if yySelShow
    label.new(bar_index, high + atr * 1.2,
              "☯ SATIŞ\n" + stars(calcScore(-1)) + "\nSL:" + str.tostring(high[1] + atr * 0.2, format.mintick),
              style = label.style_label_down, color = color.new(color.purple, 10),
              textcolor = color.white, size = size.small)

// ─── BİLGİ PANELİ ────────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 5,
                        frame_color  = color.new(color.yellow, 0),
                        frame_width  = 1,
                        border_color = color.new(color.gray, 60),
                        border_width = 1)

if barstate.islast and showPanel
    tTxt  = trendDir ==  1 ? "▲ YÜKSELİŞ" : trendDir == -1 ? "▼ DÜŞÜŞ" : "─ YATAY"
    tCol  = trendDir ==  1 ? color.lime   : trendDir == -1 ? color.red   : color.gray
    mTxt  = isMom ? "GÜÇLÜ ●" : "Düşük ○"
    mCol  = isMom ? color.lime : color.gray

    sigTxt = bullMagic ? "★ Sihirli Eng AL" : bearMagic ? "★ Sihirli Eng SAT" :
             atNaliBuy  ? "At Nalı AL"  : atNaliSel ? "At Nalı SAT"  :
             bullPin    ? "PinBar AL"   : bearPin   ? "PinBar SAT"   :
             yyBuy      ? "Ying Yang AL": yySell     ? "Ying Yang SAT": "—"
    sCol   = str.contains(sigTxt, "AL") ? color.lime : str.contains(sigTxt, "SAT") ? color.red : color.gray

    table.cell(t, 0, 0, "PIE SİSTEMİ",  text_color = color.yellow, text_size = size.small, bgcolor = color.new(color.black, 30), text_halign = text.align_center)
    table.cell(t, 1, 0, "Para Sihirbazı",text_color = color.yellow, text_size = size.tiny,  bgcolor = color.new(color.black, 30), text_halign = text.align_center)
    table.cell(t, 0, 1, "Trend",        text_color = color.silver, text_size = size.small, bgcolor = color.new(color.black, 50))
    table.cell(t, 1, 1, tTxt,           text_color = tCol,         text_size = size.small, bgcolor = color.new(color.black, 50))
    table.cell(t, 0, 2, "Momentum",     text_color = color.silver, text_size = size.small, bgcolor = color.new(color.black, 50))
    table.cell(t, 1, 2, mTxt,           text_color = mCol,         text_size = size.small, bgcolor = color.new(color.black, 50))
    table.cell(t, 0, 3, "Son Sinyal",   text_color = color.silver, text_size = size.small, bgcolor = color.new(color.black, 50))
    table.cell(t, 1, 3, sigTxt,         text_color = sCol,         text_size = size.small, bgcolor = color.new(color.black, 50))
    table.cell(t, 0, 4, "Min Teyit",    text_color = color.silver, text_size = size.small, bgcolor = color.new(color.black, 50))
    table.cell(t, 1, 4, str.tostring(minScore) + " Yıldız", text_color = color.white, text_size = size.small, bgcolor = color.new(color.black, 50))

// ─── ALARMLAR ────────────────────────────────────────────────────
anyBuy  = pinBuyShow or magBuyShow or engBuyShow or nalBuyShow or yyBuyShow
anySell = pinSelShow or magSelShow or engSelShow or nalSelShow or yySelShow

alertcondition(anyBuy,       title = "PIE — ALIŞ",      message = "PIE: ALIŞ sinyali! Trend + Supdem teyit et, R/R hesapla.")
alertcondition(anySell,      title = "PIE — SATIŞ",     message = "PIE: SATIŞ sinyali! Trend + Supdem teyit et, R/R hesapla.")
alertcondition(anyBuy or anySell, title = "PIE — Sinyal", message = "PIE: Yeni sinyal oluştu!")
alertcondition(bullMagic,    title = "PIE — Sihirli Engulf AL",  message = "PIE: Sihirli Engulf ALIŞ!")
alertcondition(bearMagic,    title = "PIE — Sihirli Engulf SAT", message = "PIE: Sihirli Engulf SATIŞ!")
